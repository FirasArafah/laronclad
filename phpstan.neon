includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - src
        - tests
    level: 8
    ignoreErrors:
        # Pest test closures expose $this as PHPUnit\Framework\TestCase
        # (Pest 3) or Pest\PendingCalls\TestCall (Pest 4). Neither
        # provides artisan() statically, but it exists at runtime
        # through Orchestra Testbench.
        - '#Call to an undefined method (PHPUnit\\Framework\\TestCase|Pest\\PendingCalls\\TestCall)::artisan\(\)#'
